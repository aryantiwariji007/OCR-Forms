# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Secrets - never commit real credentials (see .env.example for the template)
.env

# Ad-hoc sample/test photos used for manual testing, kept locally only.
# Real test fixtures live in image_script/tests/fixtures/ and are tracked.
/*.jpg
/*.jpeg
/*.png
/*.webp

# Debug/scratch output images generated by the CV debug-visualize tools
# (gauge_reader.py, digital_display_reader.py run as scripts) - not source,
# not fixtures.
image_script/*.jpg
image_script/*.jpeg
image_script/*.png
image_script/*.webp
